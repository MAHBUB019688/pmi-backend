NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pmi_ecommerce?schema=public"

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
# Returns OTP in API responses for local testing
EXPOSE_OTP=true

# Optional: Firebase Admin project for Google/Facebook login
FIREBASE_PROJECT_ID=
