NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pmi_ecommerce?schema=public"

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
# Returns OTP in API responses for local testing
EXPOSE_OTP=true

# Optional: Firebase Admin project for Google/Facebook login
FIREBASE_PROJECT_ID=

# Email (Gmail: use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
# Must use the same Gmail address as SMTP_USER (Gmail rejects other From domains)
MAIL_FROM="CARPE DIEM <your-email@gmail.com>"
# Legacy aliases also supported: EMAIL_USER / EMAIL_PASS

